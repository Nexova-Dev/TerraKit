# Build output
cli/target/
*.sqlite
*.sqlite.zst

# Swift Package Manager
# `.build/` is SPM's scratch directory and holds ~2400 files on a single `swift test`. Ignoring the
# directory rather than naming files inside it: SPM adds new subdirectories between releases, and a
# pattern list goes stale silently.
sdk/swift/.build/
.swiftpm/
Package.resolved

# The development keypair IS committed on purpose -- see PACKAGE_FORMAT.md section 11.
# Only real release keys are ignored, because losing one is recoverable and leaking one is not.
*.pem
!keys/dev-ed25519.pem

# Local caches and scratch
.cache/
.terrakit/
__pycache__/
*.pyc
.DS_Store
